@using System.Reflection
@using Balzor_Off_Canvas_Notification_History.Models

@inherits LayoutComponentBase

<style>
    .offcanvas-header {
        display: unset;
        padding: unset;
    }

    .offcanvas-body {
        padding: unset;
    }
</style>

<div class="bb-page">
    <main>
        <div class="bb-top-row px-4 d-flex justify-content-end">
            <Button Type="ButtonType.Button" Color="ButtonColor.Primary" Position="Position.Relative" @onclick="OnShowOffcanvasClick">
                <Icon Name="IconName.BellFill"></Icon>
                @if (TimedToastMessages.Count() > 0 && TimedToastMessages.Count() < 100)
                {
                    <Badge Color="BadgeColor.Danger"
                           Position="Position.Absolute"
                           Placement="BadgePlacement.TopRight"
                           IndicatorType="BadgeIndicatorType.RoundedPill"
                           VisuallyHiddenText="unread messages">@TimedToastMessages.Count()</Badge>
                }
                else if (TimedToastMessages.Count() >= 100)
                {
                    <Badge Color="BadgeColor.Danger"
                           Position="Position.Absolute"
                           Placement="BadgePlacement.TopRight"
                           IndicatorType="BadgeIndicatorType.RoundedPill"
                           VisuallyHiddenText="unread messages">99+</Badge>
                }
            </Button>
            
            <div class="pe-5"></div>

            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <div class="py-2">@Body</div>
        </article>
    </main>

</div>

<Offcanvas @ref="offcanvas" ShowCloseButton="false" Size="OffcanvasSize.Regular">
    <HeaderTemplate>
        <div class="ps-3 pt-3 pe-3">
            <h4>Notifications</h4>
            <hr />
        </div>
    </HeaderTemplate>

    <BodyTemplate>
        <div class="ps-3 pt-1 pe-3">
            <div>
                @if (TimedToastMessages.Any())
                {
                    @foreach (var timedToastMessage in TimedToastMessages)
                    {
                        <div class="row align-items-center pt-1">
                            <div class="col">
                                <small style="color: dimgrey;">@timedToastMessage.Occurrence</small>
                            </div>
                            <div class="col text-end">
                                <Button Color="ButtonColor.Dark" @onclick="@(() => OnDismissSingleToast(timedToastMessage))">
                                    <Icon Name="IconName.Trash"></Icon>
                                </Button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col pt-2">
                                <Icon Name="@timedToastMessage.IconName" Color="timedToastMessage.IconColor" />                               
                                <strong>@timedToastMessage.Title</strong>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                <p>@timedToastMessage.Message</p>
                            </div>
                        </div>

                        <hr />
                    }
                }
                else
                {
                    <p>Currently there is no notifications available.</p>
                }
            </div>

            @if (TimedToastMessages.Any())
            {
                <div class="pt-2 pb-4">
                    <Button Color="ButtonColor.Primary" @onclick="OnDismissAllToasts">
                        <Icon Name="IconName.Trash"></Icon>
                        Dismiss All
                    </Button>
                </div>
            }
        </div>
    </BodyTemplate>
</Offcanvas>

<Toasts Class="pt-5 mt-4 pe-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" StackLength="5" ShowCloseButton="true" />

<ThemeSwitcher />

@code {
    [Inject] protected ToastService ToastService { get; set; } = default!;

    public List<TimedToastMessage> TimedToastMessages { get; set; } = [];

    private Offcanvas offcanvas = default!;

    private async Task OnShowOffcanvasClick() => await offcanvas.ShowAsync();

    private void OnDismissAllToasts() => TimedToastMessages = [];

    private void OnDismissSingleToast(TimedToastMessage timedToastMessage) => TimedToastMessages.Remove(timedToastMessage);

    protected override void OnInitialized()
    {
        base.OnInitialized();

        var toastServiceType = typeof(ToastService);

        var eventInfo = toastServiceType.GetEvent("OnNotify", BindingFlags.NonPublic | BindingFlags.Instance);

        if (eventInfo != null)
        {
            var methodInfo = GetType().GetMethod(nameof(OnNotifyHandler), BindingFlags.NonPublic | BindingFlags.Instance);

            if (methodInfo != null)
            {
                var handler = Delegate.CreateDelegate(eventInfo.EventHandlerType!, this, methodInfo);

                var addMethod = eventInfo.GetAddMethod(true);

                addMethod?.Invoke(ToastService, new object[] { handler });
            }
        }
    }

    private void OnNotifyHandler(ToastMessage toastMessage)
    {
        if (toastMessage != null)
        {
            var occurrenceTime = DateTime.UtcNow;

            var iconColor = toastMessage.Type switch
            {
                ToastType.Success => IconColor.Success,
                ToastType.Primary => IconColor.Primary,
                ToastType.Secondary => IconColor.Secondary,
                ToastType.Warning => IconColor.Warning,
                ToastType.Info => IconColor.Info,
                ToastType.Danger => IconColor.Danger,
                ToastType.Dark => IconColor.Dark,
                ToastType.Light => IconColor.Light,
                _ => IconColor.None
            };

            var timedToastMessage = new TimedToastMessage(toastMessage, iconColor, occurrenceTime);

            TimedToastMessages ??= [];

            TimedToastMessages.Add(timedToastMessage);

            StateHasChanged();
        }
    }
}
