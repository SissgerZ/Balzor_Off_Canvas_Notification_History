@page "/"

<PageTitle>Index</PageTitle>

<p> Index page content is shown </p>

<Button Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="SaveEmployee">
    Test
</Button>

@code {

    [Inject] protected ToastService ToastService { get; set; } = default!;

    private void SaveEmployee()
    {
        try
        {
                             
            ToastService.Notify(new ToastMessage(type: ToastType.Success, 
                                                 title: "Something happend", 
                                                 message: $"Employee details saved successfully with a very long message.", 
                                                 iconName: IconName.CheckCircleFill,
                                                 helpText: DateTime.UtcNow.ToString()));

            ToastService.Notify(new ToastMessage(type: ToastType.Warning,
                                                 title: "Something happend",
                                                 message: $"Employee details saved successfully with a very long message.",
                                                 iconName: IconName.LightbulbFill,
                                                 helpText: DateTime.UtcNow.ToString()));

            ToastService.Notify(new ToastMessage(type: ToastType.Danger,
                                                 title: "Something happend",
                                                 message: $"Employee details saved successfully with a very long message.",
                                                 iconName: IconName.ExclamationTriangleFill,
                                                 helpText: DateTime.UtcNow.ToString()));
        }
        catch (Exception ex)
        {
            // handle exception

            ToastService.Notify(new(ToastType.Danger, $"Error: {ex.Message}."));
        }
    }
}